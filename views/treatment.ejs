            <a href="appointment.html" class="btn btn-outline btn-sm">Book This</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=400&q=80" alt="Skin cancer screening" loading="lazy" />
