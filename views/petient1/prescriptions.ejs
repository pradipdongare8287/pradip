<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="View, print, and download your prescriptions from MediCare Plus doctors." />
  <title>Prescriptions | MediCare Plus Patient Portal</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="../css/main.css" />
</head>
<body class="dashboard-body" data-dashboard data-role="patient" data-page="prescriptions" data-base-path="../">

  <div class="page-loader" id="page-loader">
    <div class="loader-pulse"></div>
    <span class="loader-text">MediCare Plus</span>
  </div>

  <div class="dashboard-layout role-patient" data-role="patient">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
        <span class="sidebar-brand-text">Medi<span>Care</span> Plus</span>
      </div>

      <div class="sidebar-user">
        <img src="" alt="Patient" data-user-avatar />
        <div class="sidebar-user-info">
          <h5 data-user-name>Demo Patient</h5>
          <span>Patient Account</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <span class="nav-section-label">Main</span>
        <a href="dashboard.html" class="nav-item"><i class="fa-solid fa-gauge-high"></i><span class="nav-label">Dashboard</span></a>
        <a href="profile.html" class="nav-item"><i class="fa-solid fa-user"></i><span class="nav-label">My Profile</span></a>
        <a href="appointments.html" class="nav-item"><i class="fa-solid fa-calendar-check"></i><span class="nav-label">Appointments</span></a>

        <span class="nav-section-label">Health Records</span>
        <a href="treatment-history.html" class="nav-item"><i class="fa-solid fa-notes-medical"></i><span class="nav-label">Treatment History</span></a>
        <a href="reports.html" class="nav-item"><i class="fa-solid fa-file-medical"></i><span class="nav-label">Reports</span></a>
        <a href="prescriptions.html" class="nav-item active"><i class="fa-solid fa-prescription"></i><span class="nav-label">Prescriptions</span></a>

        <span class="nav-section-label">Billing</span>
        <a href="payments.html" class="nav-item"><i class="fa-solid fa-credit-card"></i><span class="nav-label">Payments</span></a>

        <span class="nav-section-label">Updates</span>
        <a href="notifications.html" class="nav-item"><i class="fa-solid fa-bell"></i><span class="nav-label">Notifications</span><span class="nav-badge" data-nav-badge="notifications">2</span></a>
      </nav>

      <div class="sidebar-footer">
        <a href="../index.html" class="nav-item"><i class="fa-solid fa-house"></i><span class="nav-label">Back to Website</span></a>
        <a href="../login.html" class="nav-item" data-logout="../login.html"><i class="fa-solid fa-right-from-bracket"></i><span class="nav-label">Logout</span></a>
      </div>
    </aside>

    <div class="sidebar-overlay"></div>

    <main class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Prescriptions</h1>
            <p>Your medication history, ready to view or print.</p>
          </div>
        </div>

        <form class="topbar-search" data-topbar-search role="search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" name="q" placeholder="Search records, doctors, invoices…" aria-label="Search" />
        </form>

        <div class="topbar-right">
          <button type="button" class="topbar-btn theme-toggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>

          <div class="topbar-btn-wrap" data-notif-wrap>
            <button type="button" class="topbar-btn" aria-label="Notifications">
              <i class="fa-solid fa-bell"></i>
              <span class="badge-dot"></span>
            </button>
            <div class="notif-dropdown">
              <div class="notif-dropdown-header">
                <h4>Notifications</h4>
                <a href="#" data-mark-all-read>Mark all read</a>
              </div>
              <div class="notification-list"></div>
              <div class="notif-dropdown-footer">
                <a href="notifications.html">View All Notifications</a>
              </div>
            </div>
          </div>

          <div class="profile-dropdown" data-profile-dropdown>
            <button type="button" class="profile-trigger">
              <img src="" alt="Patient" data-user-avatar />
              <span class="profile-name" data-user-name>Demo Patient</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-user-name>Demo Patient</strong>
                <span data-user-email>patient@medicare.com</span>
              </div>
              <a href="profile.html"><i class="fa-solid fa-user"></i> My Profile</a>
              <a href="appointments.html"><i class="fa-solid fa-calendar-check"></i> My Appointments</a>
              <a href="notifications.html"><i class="fa-solid fa-bell"></i> Notifications</a>
              <div class="divider"></div>
              <a href="../login.html" class="danger" data-logout="../login.html"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <div class="dashboard-content">

        <div class="page-toolbar">
          <h2>Prescriptions</h2>
          <div class="page-toolbar-actions">
            <span class="badge badge-primary" data-rx-count>0 prescriptions</span>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:1.25rem; margin-bottom:1.75rem;" data-rx-grid></div>

        <div class="prescription-area d-none" data-rx-view></div>

      </div>
    </main>
  </div>

  <script src="../js/data.js"></script>
  <script src="../js/auth.js"></script>
  <script src="../js/components.js"></script>
  <script src="../js/appointment.js"></script>
  <script src="../js/dashboard.js"></script>
  <script src="../js/main.js"></script>
  <script src="../js/customer.js"></script>
  <script>
    document.addEventListener('medicare:ready', function () {
      MediCareAuth.requireAuth('patient', '../login.html');
      MediCareCustomer.initShell();

      var esc = MediCareCustomer.escapeHtml;
      var rxList = MediCareCustomer.getPrescriptions();
      var user = MediCareAuth.getCurrentUser();

      var doctorAvatars = {
        'Dr. Sarah Mitchell': 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=200&q=80',
        'Dr. Priya Sharma': 'https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=200&q=80',
        'Dr. Lisa Nguyen': 'https://images.unsplash.com/photo-1527613426441-4da17471b66d?auto=format&fit=crop&w=200&q=80',
      };

      document.querySelector('[data-rx-count]').textContent = rxList.length + ' prescriptions';

      var grid = document.querySelector('[data-rx-grid]');
      grid.innerHTML = rxList
        .map(function (rx) {
          return (
            '<div class="card">' +
            '<div class="card-body">' +
            '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.75rem;margin-bottom:1rem;">' +
            '<div><h4 style="margin-bottom:0.25rem;">' + esc(rx.id.toUpperCase()) + '</h4>' +
            '<span class="text-muted" style="font-size:0.85rem;">' + MediCareCustomer.fmtDate(rx.date) + '</span></div>' +
            '<span class="badge badge-primary"><i class="fa-solid fa-prescription"></i> ' + rx.medicines.length + ' meds</span>' +
            '</div>' +
            '<p style="font-size:0.9rem;color:var(--text-secondary);margin-bottom:1rem;line-height:1.6;"><strong>Diagnosis:</strong> ' + esc(rx.diagnosis) + '</p>' +
            '<div class="user-meta" style="margin-bottom:1.35rem;">' +
            '<img src="' + (doctorAvatars[rx.doctor] || '') + '" class="avatar avatar-sm" alt="' + esc(rx.doctor) + '" />' +
            '<div><div class="name">' + esc(rx.doctor) + '</div><div class="sub">' + esc(rx.specialty) + '</div></div>' +
            '</div>' +
            '<button type="button" class="btn btn-primary btn-block btn-sm" data-view-rx="' + rx.id + '">' +
            '<i class="fa-solid fa-eye"></i> View &amp; Print' +
            '</button>' +
            '</div></div>'
          );
        })
        .join('');

      var viewEl = document.querySelector('[data-rx-view]');

      function medsRows(meds) {
        return meds
          .map(function (m) {
            return (
              '<tr><td>' + esc(m.name) + '</td><td>' + esc(m.dosage) + '</td><td>' + esc(m.frequency) + '</td><td>' + esc(m.duration) + '</td></tr>'
            );
          })
          .join('');
      }

      function buildRxHtml(rx) {
        return (
          '<div class="prescription-header">' +
          '<div class="rx-brand">' +
          '<span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>' +
          '<div><h2>MediCare Plus</h2><p>1250 Healing Way, Suite 100, Health City, HC 90210</p></div>' +
          '</div>' +
          '<div class="rx-meta"><strong>' + esc(rx.id.toUpperCase()) + '</strong><span>Date: ' + MediCareCustomer.fmtDate(rx.date) + '</span></div>' +
          '</div>' +
          '<div class="prescription-patient">' +
          '<div class="rx-field"><label>Patient Name</label><span>' + esc(user ? user.name : 'Patient') + '</span></div>' +
          '<div class="rx-field"><label>Doctor</label><span>' + esc(rx.doctor) + '</span></div>' +
          '<div class="rx-field"><label>Department</label><span>' + esc(rx.department) + '</span></div>' +
          '</div>' +
          '<div class="prescription-rx">' +
          '<div class="rx-symbol">℞</div>' +
          '<table class="prescription-meds">' +
          '<thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th></tr></thead>' +
          '<tbody>' + medsRows(rx.medicines) + '</tbody>' +
          '</table>' +
          '</div>' +
          '<div class="prescription-notes">' +
          '<h5><i class="fa-solid fa-note-sticky"></i> Doctor\'s Notes</h5>' +
          '<p>' + esc(rx.notes) + '</p>' +
          '</div>' +
          '<div class="prescription-footer">' +
          '<div><strong style="display:block;margin-bottom:0.35rem;color:var(--heading);">Diagnosis</strong>' +
          '<p style="max-width:340px;font-size:0.9rem;color:var(--text-secondary);margin:0;">' + esc(rx.diagnosis) + '</p></div>' +
          '<div class="rx-signature"><div class="sig-line"></div><span>' + esc(rx.doctor) + '</span></div>' +
          '</div>' +
          '<div class="prescription-actions">' +
          '<button type="button" class="btn btn-outline" data-close-rx><i class="fa-solid fa-xmark"></i> Close</button>' +
          '<button type="button" class="btn btn-primary" data-print-rx><i class="fa-solid fa-print"></i> Print</button>' +
          '<button type="button" class="btn btn-secondary" data-download-rx><i class="fa-solid fa-download"></i> Download PDF</button>' +
          '</div>'
        );
      }

      function openRx(id) {
        var rx = rxList.filter(function (r) { return r.id === id; })[0];
        if (!rx) return;
        viewEl.innerHTML = buildRxHtml(rx);
        viewEl.classList.remove('d-none');
        viewEl.scrollIntoView({ behavior: 'smooth', block: 'start' });

        viewEl.querySelector('[data-close-rx]').addEventListener('click', function () {
          viewEl.classList.add('d-none');
        });
        viewEl.querySelector('[data-print-rx]').addEventListener('click', function () {
          window.print();
        });
        viewEl.querySelector('[data-download-rx]').addEventListener('click', function () {
          MediCareCustomer.toast('PDF download simulated (demo) — your prescription would save now.', 'success');
        });
      }

      grid.querySelectorAll('[data-view-rx]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          openRx(btn.getAttribute('data-view-rx'));
        });
      });
    });
  </script>
</body>
</html>
