<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Reset your MediCare Plus account password securely by email." />
  <meta name="keywords" content="forgot password, reset password, hospital account recovery" />
  <meta name="author" content="MediCare Plus" />
  <title>Forgot Password | MediCare Plus</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  <link rel="stylesheet" href="css/main.css" />
</head>
<body data-page="forgot-password">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <div class="page-loader" id="page-loader">
    <div class="loader-pulse"></div>
    <span class="loader-text">MediCare Plus</span>
  </div>

  <main id="main-content" class="auth-page centered">
    <div class="auth-card">
      <div class="d-flex justify-center mb-4">
        <a href="index.html" class="logo">
          <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
          <span class="logo-text">Medi<span>Care</span> Plus</span>
        </a>
      </div>

      <div class="auth-header">
        <h1>Forgot Password?</h1>
        <p>Enter your account email and we'll generate a password reset token for you.</p>
      </div>

      <div class="alert alert-info">
        <i class="fa-solid fa-flask"></i>
        <span>Demo mode: no real email is sent. Your reset token will appear below the form so you can complete the reset instantly.</span>
      </div>

      <form data-forgot-form novalidate>
        <div class="form-group">
          <label class="form-label" for="forgot-email">Email Address <span class="required">*</span></label>
          <div class="input-icon">
            <i class="fa-regular fa-envelope"></i>
            <input type="email" id="forgot-email" name="email" class="form-control" placeholder="you@example.com" required />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="reset-token-display">Your Reset Token</label>
          <input type="text" id="reset-token-display" name="token" class="form-control" placeholder="Token will appear here after submitting" readonly />
          <p class="form-hint">Copy this token into the "New Password" form below to complete your reset.</p>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">
          <i class="fa-solid fa-key"></i> Send Reset Token
        </button>
      </form>

      <div class="auth-divider"><span>then set a new password</span></div>

      <form data-reset-form novalidate>
        <div class="form-group">
          <label class="form-label" for="reset-email">Email Address <span class="required">*</span></label>
          <input type="email" id="reset-email" name="email" class="form-control" placeholder="you@example.com" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="reset-token">Reset Token <span class="required">*</span></label>
            <input type="text" id="reset-token" name="token" class="form-control" placeholder="e.g. A1B2C3D4" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="reset-password">New Password <span class="required">*</span></label>
            <input type="password" id="reset-password" name="password" class="form-control" placeholder="Min. 6 characters" required minlength="6" />
          </div>
        </div>
        <button type="submit" class="btn btn-secondary btn-lg btn-block">
          <i class="fa-solid fa-lock-open"></i> Reset Password
        </button>
      </form>

      <p class="auth-footer">
        Remembered your password? <a href="login.html">Back to Sign In</a>
      </p>
    </div>
  </main>

  <div class="toast-container"></div>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script src="js/data.js"></script>
  <script src="js/auth.js"></script>
  <script src="js/components.js"></script>
  <script src="js/appointment.js"></script>
  <script src="js/dashboard.js"></script>
  <script src="js/main.js"></script>
  <script src="js/pages.js"></script>
</body>
</html>
