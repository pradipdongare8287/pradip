<%-include('header.ejs')%>

      <div class="dashboard-content">

        <div class="page-toolbar">
          <h2>My Appointments</h2>
          
        </div>


          <div style="max-width:700px;margin:40px auto;background:#ffffff;padding:35px;border-radius:20px;box-shadow:0px 10px 35px rgba(0,0,0,0.15);border-top:6px solid #0d6efd;">

    <h2 style="margin:0;text-align:center;font-family:Arial;color:#0d6efd;font-size:32px;">
        <i class="fa-solid fa-calendar-check"></i> Book Appointment
    </h2>

    <p style="text-align:center;color:#777;margin-top:8px;margin-bottom:30px;">
        Fill the details below to schedule your appointment.
    </p>

    <form action="/patient/add_appointment" method="post">

        <div style="margin-bottom:20px;">
            <label style="display:block;font-weight:bold;font-size:15px;color:#333;margin-bottom:8px;">
                <i class="fa-solid fa-user-doctor" style="color:#0d6efd;"></i> Choose Doctor
            </label>

            <select name="doctor" style="width:100%;padding:14px;border:2px solid #d9e7ff;border-radius:10px;font-size:15px;outline:none;background:#f8fbff;">
                <option value="">Select Doctor</option>
              <% for(var i=0;i<doctors.length;i++){ %>
                <option><%=doctors[i].doc_name%></option>
                <% } %>
            </select>
        </div>

        <div style="display:flex;gap:20px;flex-wrap:wrap;">

            <div style="flex:1;min-width:250px;">
                <label style="display:block;font-weight:bold;font-size:15px;color:#333;margin-bottom:8px;">
                    <i class="fa-solid fa-calendar-days" style="color:#198754;"></i> Appointment Date
                </label>

                <input type="date" name="date"
                style="width:100%;padding:14px;border:2px solid #d9e7ff;border-radius:10px;font-size:15px;background:#f8fbff;outline:none;">
            </div>

            <div style="flex:1;min-width:250px;">
                <label style="display:block;font-weight:bold;font-size:15px;color:#333;margin-bottom:8px;">
                    <i class="fa-solid fa-clock" style="color:#ff9800;"></i> Appointment Time
                </label>

                <input type="time" name="time"
                style="width:100%;padding:14px;border:2px solid #d9e7ff;border-radius:10px;font-size:15px;background:#f8fbff;outline:none;">
            </div>

        </div>

        <div style="margin-top:20px;">
            <label style="display:block;font-weight:bold;font-size:15px;color:#333;margin-bottom:8px;">
                <i class="fa-solid fa-notes-medical" style="color:#dc3545;"></i> Reason for Appointment
            </label>

            <textarea name="appoi_reason" rows="5" placeholder="Describe your health issue..."
            style="width:100%;padding:15px;border:2px solid #d9e7ff;border-radius:10px;font-size:15px;background:#f8fbff;resize:none;outline:none;"></textarea>
        </div>

        <div style="margin-top:30px;text-align:center;">

            <button type="submit"
            style="background:linear-gradient(90deg,#0d6efd,#00b4ff);color:white;border:none;padding:15px 45px;font-size:17px;font-weight:bold;border-radius:50px;cursor:pointer;box-shadow:0px 8px 20px rgba(13,110,253,.35);">
                <i class="fa-solid fa-calendar-plus"></i> Book New Appointment
            </button>

        </div>

    </form>

</div>


        <div class="filter-bar">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="form-control" placeholder="Search by doctor, department, or reason…" />
          </div>
          <select class="form-control">
            <option value="all">All Statuses</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>

        <div data-tabs>
          <div class="tabs">
            <button type="button" class="tab-btn active" data-tab="upcoming">
              <i class="fa-solid fa-calendar-day"></i> Upcoming
            </button>
            <button type="button" class="tab-btn" data-tab="past">
              <i class="fa-solid fa-calendar-check"></i> Past
            </button>
            <button type="button" class="tab-btn" data-tab="all">
              <i class="fa-solid fa-layer-group"></i> All
            </button>
          </div>

          <div class="tab-panel active" data-tab-panel="upcoming">
            <div class="table-wrapper">
              <table class="table">
                <thead>
                  <tr>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <!-- <th>Actions</th> -->
                  </tr>
                </thead>
                <tbody>
                  <% for(var a=0;a<data.length;a++){ %>
                  <tr>
                    <td><div class="table-user"><img src="/images/<%=data[a].doctor_image%>" alt="" /><div><strong><%=data[a].Doctor%></strong></div></div></td>
                    <td><%=data[a].Date%></td>
                    <td><%=data[a].Time%></td>
                    <td><%=data[a].Appointment_Reason%></td>
                    <td><span class="badge badge-approved"><%=data[a].Status%></span></td>
                  
                  </tr>
                  <% } %>
                  
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>

<%-include('footer.ejs')%>