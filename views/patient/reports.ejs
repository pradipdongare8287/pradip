<%-include('header.ejs');%>
      <div class="dashboard-content">

        <div class="page-toolbar">
          <h2>Medical Reports</h2>
          <div class="page-toolbar-actions">
            <span class="badge badge-success">4 ready</span>
            <span class="badge badge-warning">1 pending</span>
          </div>
        </div>

        <div class="filter-bar">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="form-control" placeholder="Search by report name, type, or doctor…" />
          </div>
          <select class="form-control">
            <option value="all">All Types</option>
            <option value="Lab Test">Lab Test</option>
            <option value="Radiology">Radiology</option>
            <option value="Cardiac Test">Cardiac Test</option>
          </select>
        </div>

        <div class="table-wrapper">
          <table class="table">
            <thead>
              <tr>
                <th>Report Name</th>
                <th>Type</th>
                <th>Ordered By</th>
                <th>Date</th>
                <th>Size</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% for(var i=0;i<report.length;i++){ %>
              <tr>
                <td><div class="table-user"><div class="stat-icon blue" style="width:38px;height:38px;font-size:1rem;"><i class="<%=report[i].report_logo%>"></i></div><div><strong>complete <%=report[i].report_title%></strong><span><%=report[i].report_Type%></span></div></div></td>
                <td><%=report[i].report_title%></td>
                <td><%=report[i].report_submited_doctor_name%></td>
                <td><%=report[i].report_date%></td>
                <td>420 KB</td>
                <td><span class="badge badge-success"><%=report[i].report_status%></span></td>
                <td class="table-actions"><button type="button" class="btn btn-sm btn-outline"><i class="fa-solid fa-download"></i> Download</button></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>
    </main>
  </div>
<%-include('footer.ejs');%>