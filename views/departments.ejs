<%-include('header.ejs');%>
    <section class="page-banner">
      <div class="container">
        <h1>Our Departments</h1>
        <div class="breadcrumb">
          <a href="index.html">Home</a>
          <i class="fa-solid fa-chevron-right"></i>
          <span>Departments</span>
        </div>
      </div>
    </section>

    <!-- Department Grid -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <span class="eyebrow">Centers of Excellence</span>
          <h2>Eight Specialized Care Units</h2>
          <p>Every department is staffed by board-certified specialists and equipped with modern diagnostic and treatment technology, all under one roof.</p>
        </div>
         <div class="dept-grid">
          <% for(var a=0;a<department.length;a++){ %>
          <article class="dept-card card-interactive" data-aos="fade-up">
            <div class="dept-card-icon"><i class="<%=department[a].icon%>"></i></div>
            <h3><%=department[a].dname%></h3>
            <p><%=department[a].description%></p>
            <div class="dept-card-meta"><span><i class="fa-solid fa-user-doctor"></i><%=department[a].doctor%> Doctors</span><span><i class="fa-solid fa-bed"></i><%=department[a].beds%> Beds</span></div>
            <a href="/doctors" class="btn btn-ghost btn-sm">View Doctors</a>
          </article>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Department Detail Rows -->
    <section class="section bg-alt">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <span class="eyebrow">Learn More</span>
          <h2>Department Details</h2>
          <p>Capacity, specialist coverage, and what each unit treats.</p>
        </div>
        <div class="service-list" data-departments-detail></div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container">
        <div class="cta-banner" data-aos="fade-up">
          <div class="container">
            <h2>Not Sure Which Department You Need?</h2>
            <p>Our care coordinators can help match you with the right specialist in minutes.</p>
            <div class="btn-group">
              <a href="doctors.html" class="btn btn-white btn-lg"><i class="fa-solid fa-user-doctor"></i> Browse All Doctors</a>
              <a href="contact.html" class="btn btn-outline-white btn-lg"><i class="fa-solid fa-phone"></i> Talk to Us</a>
            </div>
          </div>
        </div>
      </div>
    </section>
<%-include('footer.ejs');%>
  