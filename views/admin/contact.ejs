<%-include('header.ejs')%>
<div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Add Website Contact Section</h1>
            <p>Hospital Contact &amp; Page</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="dashboard-search" placeholder="Quick search doctors, patients…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="/admin/logout" class="danger logout-btn" ><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>


                

        <form action="/admin/save_contact" method="post" enctype="multipart/form-data"
                    style="max-width:700px; margin:30px auto; padding:30px; background:#fff; border-radius:12px; box-shadow:0 8px 25px rgba(0,0,0,0.15); border-top:5px solid #0d6efd;">

                    <!-- Heading -->
                    <h4 style="text-align:center; color:#0b7219; margin-bottom:10px;">
                        <i class="fa fa-phone"></i>&nbsp;Add Contact
                    </h4>

                    <p style="text-align:center; color:#666; margin-bottom:30px;">
                        Fill in the details below to <b>Add</b> contact
                    </p>

                    <!-- Mission Icon -->
                    <label style="font-weight:bold; color:#333; display:block; margin-bottom:8px;">
                        <i class="fa fa-icons"></i> Contact Icon
                    </label>

                    <input type="text" name="con_icon" placeholder="fa fa-cogs" value=""
                        style="width:100%; padding:12px; border:1px solid #ced4da; border-radius:8px; font-size:15px; margin-bottom:20px; outline:none;">

                    <!-- Mission Name -->
                    <label style="font-weight:bold; color:#333; display:block; margin-bottom:8px;">
                        <i class="fa fa-flag"></i> Contact Name
                    </label>

                    <input type="text" name="con_name" placeholder="Enter Contact Name" value=""
                        style="width:100%; padding:12px; border:1px solid #ced4da; border-radius:8px; font-size:15px; margin-bottom:20px; outline:none;">


                    <!-- Mission Description -->
                    <label style="font-weight:bold; color:#333; display:block; margin-bottom:8px;">
                        <i class="fa fa-align-left"></i> Contact Description
                    </label>

                    <textarea name="Con_description" rows="5" placeholder="Contact Description"
                        style="width:100%; padding:12px; border:1px solid #ced4da; border-radius:8px; resize:none; font-size:15px; margin-bottom:25px; outline:none;">
                   
                    </textarea>

                    <!-- Buttons -->
                    <div style="display:flex; justify-content:space-between; align-items:center;">

                        <a href=""><button type="reset"
                            style="background:#dc3545; color:#fff; border:none; padding:12px 28px; border-radius:8px; font-size:15px; cursor:pointer; transition:0.3s;">
                            <i class="fa fa-refresh"></i> Reset
                        </button></a>

                       <a><button type="submit"
                            style="background:#198754; color:#fff; border:none; padding:12px 28px; border-radius:8px; font-size:15px; cursor:pointer; transition:0.3s;">
                            <i class="fa fa-save"></i> Save Contact
                        </button></a>

                    </div>

                   

    </form>
