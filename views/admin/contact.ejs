        <div class="table-wrapper"
    style="background:#fff; padding:20px; border-radius:12px; box-shadow:0 5px 20px rgba(0,0,0,0.08); margin-top:20px; overflow-x:auto;">

    <h4 style="text-align:center; color:#1d0606; margin-bottom:20px; font-weight:bold; font-size:24px;">
        <i class="fa-solid fa-phone" style="color:#0d6efd;"></i>
        &nbsp;Add New Contact Method
    </h4>

    <table id="doctors-table"
        style="width:100%; border-collapse:collapse; font-family:Arial, Helvetica, sans-serif; overflow:hidden; border-radius:10px;">

        <thead>
            <tr style="background:linear-gradient(90deg,#0d6efd,#0099ff); color:white; text-align:center;">

                <th style="padding:14px; border:1px solid #dee2e6;">Sr.No</th>
                <th style="padding:14px; border:1px solid #dee2e6;">Contact Logo</th>
                <th style="padding:14px; border:1px solid #dee2e6;">Contact Name</th>
                <th style="padding:14px; border:1px solid #dee2e6;">Contact Description</th>
                <th style="padding:14px; border:1px solid #dee2e6;">Action</th>

            </tr>
        </thead>

        <% for(var d=0; d<contact.length; d++){ %>

        <tbody>

            <tr style="text-align:center; transition:0.3s;">

                <td style="padding:12px; border:1px solid #e5e5e5; font-weight:bold;">
                    <%= d+1 %>
                </td>

                <td style="padding:12px; border:1px solid #e5e5e5; font-size:20px;">
                    <%= contact[d].clogo %>
                </td>

                <td style="padding:12px; border:1px solid #e5e5e5; font-weight:600;">
                    <%= contact[d].cnaem %>
                </td>

                <td style="padding:12px; border:1px solid #e5e5e5; color:#555;">
                    <%= contact[d].cdiscription %>
                </td>

                <td style="padding:12px; border:1px solid #e5e5e5;">

                    <a href="/admin/delete_contact/<%=contact[d].cid%>"
                        onclick="return confirm('Are you sure you want to delete this department?')">

                        <button
                            style="background:#dc3545; color:white; border:none; padding:8px 12px; border-radius:6px; cursor:pointer; margin-right:5px; transition:.3s;">
                            <i class="fa fa-trash"></i>
                        </button>

                    </a>

                    <a href="/admin/edit_contact/<%=contact[d].cid%>"
                        onclick="return confirm('Are you sure you want to edit this contact?')">

                        <button
                            style="background:#0d6efd; color:white; border:none; padding:8px 12px; border-radius:6px; cursor:pointer; transition:.3s;">
                            <i class="fa fa-pencil"></i>
                        </button>

                    </a>

                </td>

            </tr>

        </tbody>

        <% } %>

    </table>

</div>
<!-- =========================================GOOGLE MAP SETTING================================================
=========================================================================================================== -->


<div style="width:70%; margin:30px auto; background:#fff; border-radius:10px; box-shadow:0px 0px 15px rgba(0,0,0,0.15); padding:20px;">

    <h3 style="text-align:center; color:#0d6efd; margin-bottom:20px;">
        <i class="fa fa-map-marker"></i> Google Map Settings
    </h3>

    <form action="/admin/save_map" method="post">

        <table style="width:100%; border-collapse:collapse;">

            <tr>
                <th style="width:30%; padding:15px; background:#0d6efd; color:white; text-align:left; border:1px solid #ddd;">
                    <i class="fa fa-map"></i> Google Map Embed Link
                </th>

                <td style="padding:15px; border:1px solid #ddd;">
                    <textarea
                        name="map"
                        rows="6"
                        placeholder="Paste Google Map Embed iframe code here..."
                        style="width:100%; padding:12px; border:1px solid #ccc; border-radius:6px; resize:none; font-size:15px;"
                        required>
                      <%=map.mlink%>
                      </textarea>
                </td>
            </tr>

            <tr>
                <td colspan="2" style="text-align:center; padding:20px; border:1px solid #ddd;">

                    <button type="submit"
                        style="background:#198754; color:white; border:none; padding:10px 30px; border-radius:6px; cursor:pointer; font-size:16px; margin-right:10px;">
                        <i class="fa fa-save"></i> Save Map
                    </button>

                    <button type="reset"
                        style="background:#dc3545; color:white; border:none; padding:10px 30px; border-radius:6px; cursor:pointer; font-size:16px;">
                        <i class="fa fa-refresh"></i> Reset
                    </button>

                </td>
            </tr>

        </table>

    </form>

</div>


<!-- ==================================================================================================================
================================================================================================================== -->



</div>

<%-include('footer.ejs')%>