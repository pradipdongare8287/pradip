<%- include('header.ejs') %>
<div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Add Website Blog Section</h1>
            <p>Hospital Blog &amp; Page</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="dashboard-search" placeholder="Quick search doctors, patients…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="/admin/logout" class="danger logout-btn" ><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

<div style="max-width:800px;margin:auto;background:#fff;padding:40px;border-radius:25px;box-shadow:0 15px 45px rgba(0,0,0,.12);border:1px solid #e8eef7;">

    <div style="text-align:center;margin-bottom:35px;">
        <div style="width:90px;height:90px;background:linear-gradient(135deg,#007bff,#00c6ff);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:white;font-size:35px;box-shadow:0 10px 25px rgba(0,123,255,.4);">
            <i class="fa fa-pencil"></i>
        </div>

        <h2 style="margin:18px 0 5px;font-size:34px;color:#0d1b4c;font-weight:bold;">
            Add New Blog
        </h2>

        <p style="margin:0;color:#7b869d;font-size:15px;">
            Create an attractive healthcare blog for your website
        </p>
    </div>

    <form action="/admin/save_blog" method="post" enctype="multipart/form-data">

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:25px;">

            <div>
                <label style="display:block;font-weight:600;margin-bottom:8px;color:#2c3e50;">
                    Department
                </label>

                <select name="department"
                style="width:100%;padding:14px;border:1px solid #d9e3f2;border-radius:12px;font-size:15px;background:#f9fbff;outline:none;">
                    <option>Select Department</option>
                    <% for(var i =0;i<department.length;i++){ %>
                    <option><%=department[i].dname%></option>
                        <% } %>
                </select>
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:8px;color:#2c3e50;">
                    Blog Date
                </label>

                <input type="date" name="date"
                style="width:100%;padding:14px;border:1px solid #d9e3f2;border-radius:12px;background:#f9fbff;font-size:15px;outline:none;">
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:8px;color:#2c3e50;">
                    Doctor Name
                </label>

                <input type="text" name="doctor"
                placeholder="Dr. John Smith"
                style="width:100%;padding:14px;border:1px solid #d9e3f2;border-radius:12px;background:#f9fbff;font-size:15px;outline:none;">
            </div>

            <div>
                <label style="display:block;font-weight:600;margin-bottom:8px;color:#2c3e50;">
                    Upload Blog Image
                </label>

                <input type="file" name="blog_photo"
                style="width:100%;padding:11px;border:2px dashed #8fc3ff;border-radius:12px;background:#f7fbff;">
            </div>

        </div>

        <div style="margin-top:25px;">
            <label style="display:block;font-weight:600;margin-bottom:8px;color:#2c3e50;">
                Blog Heading
            </label>

            <input type="text" name="heading"
            placeholder="Enter Attractive Blog Heading"
            style="width:100%;padding:15px;border:1px solid #d9e3f2;border-radius:12px;background:#f9fbff;font-size:16px;outline:none;">
        </div>

        <div style="margin-top:25px;">
            <label style="display:block;font-weight:600;margin-bottom:8px;color:#2c3e50;">
                Blog Description
            </label>

            <textarea name="description" rows="7"
            placeholder="Write Blog Description..."
            style="width:100%;padding:16px;border:1px solid #d9e3f2;border-radius:12px;background:#f9fbff;font-size:15px;resize:none;outline:none;"></textarea>
        </div>
        <h5 style="margin-left:30px;">NOTE :- When you form will be submited you are automaticaly redirect on this page </h5>
        <div style="margin-top:35px;text-align:center;">

            <button
            style="background:linear-gradient(135deg,#007bff,#00c6ff);padding:15px 60px;border:none;border-radius:50px;color:white;font-size:18px;font-weight:bold;cursor:pointer;box-shadow:0 10px 25px rgba(0,123,255,.35);transition:.3s;">
                <i class="fa fa-save"></i> Publish Blog
            </button>

        </div>

    </form>

              

                

</div>
  <div style="background:#ffffff;padding:25px;border-radius:20px;box-shadow:0px 15px 40px rgba(0,0,0,.12);overflow-x:auto;border:1px solid #e8edf7;margin-top:30px;">

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">

        <h2 style="margin:0;font-size:28px;color:#1b2559;font-weight:bold;">
            <i class="fa fa-newspaper-o" style="color:#0d6efd;"></i>
            Blog Management
        </h2>

        <span style="background:linear-gradient(135deg,#0d6efd,#00b4ff);color:white;padding:10px 18px;border-radius:30px;font-weight:bold;font-size:14px;box-shadow:0 8px 20px rgba(13,110,253,.35);">
            Total Blogs : 25
        </span>

    </div>
            </div>
<div class=""> 
                <table style="width:100%;border-collapse:separate;border-spacing:0;font-family:Segoe UI,sans-serif;overflow:hidden;border-radius:18px;margin-top:50px;">

                    <thead>

                        <tr style="background:linear-gradient(135deg,#0d6efd,#00b4ff);color:white;">

                            <th style="padding:18px;">Sr.no</th>

                            <th style="padding:18px;">Department</th>

                            <th style="padding:18px;">Photo</th>

                            <th style="padding:18px;">Date</th>

                            <th style="padding:18px;">Doctor</th>

                            <th style="padding:18px;">Heading</th>

                            <th style="padding:18px;">Description</th>

                            <th style="padding:18px;">Action</th>

                        </tr>

                </thead>

            
                <tbody>
                    <% for(var a=0;a<data.length;a++){ %>
                        <tr style="background:#f9fcff;transition:.3s;">

                               <td style="padding:18px;text-align:center;font-weight:bold;"><%=a+1%></td>

                                <td style="padding:18px;">
                                <span style="background:#dbeafe;color:#0d6efd;padding:7px 14px;border-radius:30px;font-size:13px;font-weight:bold;">
                               <%=data[a].department%>
                                </span>
                                </td>

                                <td style="padding:18px;">
                                <img src="/images/<%=data[a].Blog_image%>"
                                style="width:70px;height:55px;border-radius:12px;object-fit:cover;border:3px solid #ffffff;box-shadow:0 5px 15px rgba(0,0,0,.15);">
                                </td>

                                <td style="padding:18px;font-weight:600;">
                                    <%=data[a].date%>
                                </td>

                                <td style="padding:18px;">
                                    <%=data[a].doctor%>
                                </td>

                                <td style="padding:18px;font-weight:bold;color:#1b2559;">
                                    <%=data[a].heading%>
                                </td>

                                <td style="padding:18px;color:#666;">
                                    <%=data[a].description%>
                                </td>

                                <td style="padding:18px;white-space:nowrap;">

                                <a href="#"
                                style="display:inline-flex;justify-content:center;align-items:center;width:42px;height:42px;background:linear-gradient(135deg,#ffc107,#ff9800);border-radius:12px;color:white;text-decoration:none;font-size:18px;box-shadow:0 8px 18px rgba(255,193,7,.35);margin-right:10px;">

                                <i class="fa fa-pencil"></i>

                                </a>

                                <a href="/admin/delete_blog/<%=data[a].bid%>"
                                style="display:inline-flex;justify-content:center;align-items:center;width:42px;height:42px;background:linear-gradient(135deg,#ff4b5c,#ff1744);border-radius:12px;color:white;text-decoration:none;font-size:18px;box-shadow:0 8px 18px rgba(255,23,68,.35);">

                                <i class="fa fa-trash"></i>

                                </a>

                                </td>

                        </tr>
                        <% } %>

                </tbody>

                </table>
            </div>


</body>
</html>

</div>
<%- include('footer.ejs') %>
