<%-include('header.ejs')%>


    <div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Patients</h1>
            <p>Registered patients across the hospital</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="patients-search" placeholder="Search patients by name, email…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings.html"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="login.html" class="danger logout-btn" data-logout="login.html"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <main class="dashboard-content">
        <div class="page-toolbar">
          <h2>All Patients <span class="badge badge-primary" id="patients-count">0 of 0</span></h2>
          <div class="page-toolbar-actions">
            <select id="patients-status-filter" class="form-control" style="max-width:180px;">
              <option value="all">All Status</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
            <button type="button" class="btn btn-outline" data-export-csv="#patients-table" data-filename="patients.csv">
              <i class="fa-solid fa-file-arrow-down"></i> Export CSV
            </button>
            <button type="button" class="btn btn-primary" id="add-patient-btn">
              <i class="fa-solid fa-plus"></i> Add Patient
            </button>
          </div>
        </div>

        <div class="table-wrapper">
          <table class="table"  >
            <thead>
              <tr>
                <th>Patient</th>
                <th>Contact</th>
                <th>Gender</th>
                <th>Blood Group</th>
                <th>Date Of Birth</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% for(var i=0;i<patient.length;i++){ %>
                <tr>
                  <td>
                    <img src="/images/<%=patient[i].p_photo%>" alt="<%=patient[i].pname%>" style="height:50px;width:50px;border-radius:50%;"/>
                    <%=patient[i].pname%><br/><strong>Email :-</strong>&nbsp;&nbsp;&nbsp;<%=patient[i].pemail%>

                  </td>
                  <td><%=patient[i].pphone%></td>
                  <td><%=patient[i].p_gender%></td>
                  <td><%=patient[i].p_bloodgroup%></td>
                  <td><%=patient[i].p_dob%></td>
                  
                  <% if(patient[i].Patient_Status=='Active'){ %> 
                    <td style="color:green;"><%=patient[i].Patient_Status%>
                    </td>
                    <% } else if(patient[i].Patient_Status=='Discharges') { %>
                      <td style="color:rgb(19, 155, 173);"><%=patient[i].Patient_Status%>
                    </td>
                      <% } else{ %>
                      <td style="color:red;">
                        <%=patient[i].Patient_Status%>
                    </td>
                     <%  } %>


                
                  <td style="padding: 14px 16px;">
                      <div style="display: flex;align-items: center;gap: 8px;">

                          <!-- Edit Button -->
                          <a href="/admin/edit_patient/<%= patient[i].pid %>"
                            style="display: inline-flex;align-items: center;gap: 7px;padding: 9px 16px;border-radius: 10px;background: linear-gradient(135deg, #4f46e5, #6366f1);color: #ffffff;text-decoration: none;font-size: 13px;font-weight: 600;letter-spacing: 0.2px;box-shadow: 0 4px 10px rgba(79,70,229,0.25);transition: all 0.25s ease;"
                            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 7px 16px rgba(79,70,229,0.35)'"
                            onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 10px rgba(79,70,229,0.25)'">
                              <span style="font-size: 14px;">✎</span>
                              Edit
                          </a>


                          <!-- Delete Button -->
                          <a href="/admin/delete_patient/<%= patient[i].pid %>"
                            onclick="return confirm('Are you sure you want to delete <%=patient[i].pname%> patient')"
                            style="display: inline-flex;align-items: center;gap: 7px;padding: 9px 16px;border-radius: 10px;background: linear-gradient(135deg, #ef4444, #f43f5e);color: #ffffff;text-decoration: none;font-size: 13px;font-weight: 600;letter-spacing: 0.2px;box-shadow: 0 4px 10px rgba(239,68,68,0.25);transition: all 0.25s ease;"
                            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 7px 16px rgba(239,68,68,0.35)'"
                            onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 10px rgba(239,68,68,0.25)'">

                              <span style="font-size: 14px;">✕</span>
                              Delete
                          </a>

                      </div>

                  </td>
                </tr>
                <% } %>
            </tbody>
          </table>
        </div>
        <div class="pagination" id="patients-pagination"></div>
      </main>
    </div>
  </div>

  <!-- View Patient Modal -->
  <div class="modal-backdrop" id="patient-view-modal-backdrop"></div>
  <div class="modal" id="patient-view-modal" role="dialog" aria-modal="true" aria-labelledby="patient-view-title">
    <div class="modal-header">
      <h3 id="patient-view-title">Patient Details</h3>
      <button type="button" class="modal-close" data-modal-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body" id="patient-view-body"></div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" data-modal-close>Close</button>
    </div>
  </div>

  <!-- Add / Edit Patient Modal -->
  <div class="modal-backdrop" id="patient-modal-backdrop"></div>
  <div class="modal modal-lg" id="patient-modal" role="dialog" aria-modal="true" aria-labelledby="patient-modal-title">
    <div class="modal-header">
      <h3 id="patient-modal-title">Add New Patient</h3>
      <button type="button" class="modal-close" data-modal-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form id="patient-form">
      <div class="modal-body">
        <input type="hidden" name="id" />
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="pat-name">Full Name <span class="required">*</span></label>
            <input type="text" id="pat-name" name="name" class="form-control" placeholder="Jane Doe" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="pat-email">Email <span class="required">*</span></label>
            <input type="email" id="pat-email" name="email" class="form-control" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="pat-phone">Phone</label>
            <input type="tel" id="pat-phone" name="phone" class="form-control" />
          </div>
          <div class="form-group">
            <label class="form-label" for="pat-age">Age</label>
            <input type="number" id="pat-age" name="age" class="form-control" min="0" max="120" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="pat-gender">Gender</label>
            <select id="pat-gender" name="gender" class="form-control">
              <option value="">Select</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="pat-bloodGroup">Blood Group</label>
            <select id="pat-bloodGroup" name="bloodGroup" class="form-control">
              <option value="">Select</option>
              <option>A+</option><option>A-</option>
              <option>B+</option><option>B-</option>
              <option>O+</option><option>O-</option>
              <option>AB+</option><option>AB-</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="pat-address">Address</label>
          <input type="text" id="pat-address" name="address" class="form-control" placeholder="Street, City, State" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Patient</button>
      </div>
    </form>
  </div>

<%-include('footer.ejs')%>




