<%-include('header.ejs');%>

    <div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Departments</h1>
            <p>Clinical departments &amp; specializations</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="departments-search" placeholder="Search departments…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings.html"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="login.html" class="danger logout-btn" data-logout="login.html"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <main class="dashboard-content">
        <div class="stat-cards" style="margin-bottom:1.75rem;">
          <div class="stat-card">
            <div class="stat-card-icon blue"><i class="fa-solid fa-sitemap"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Total Departments</div>
              <div class="stat-card-value" id="dept-kpi-total">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon green"><i class="fa-solid fa-bed"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Total Beds</div>
              <div class="stat-card-value" id="dept-kpi-beds">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon orange"><i class="fa-solid fa-user-doctor"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Assigned Doctors</div>
              <div class="stat-card-value" id="dept-kpi-doctors">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon purple"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Unstaffed</div>
              <div class="stat-card-value" id="dept-kpi-unstaffed">0</div>
            </div>
          </div>
        </div>

    <div class="modal-header">
      <h3 id="department-modal-title" style="margin-left:300px;font-size:30px;">Update Department</h3>
      <button type="button" class="modal-close" data-modal-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form action="/admin/update_department/<%=deta.did%>" method="post">
      <div class="modal-body">
        
        <div class="form-group">
          <label class="form-label" for="dept-name">Department Name <span class="required">*</span></label>
          <input type="text" id="dept-name" name="name" class="form-control" placeholder="Cardiology" value="<%=deta.dname%>" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="dept-icon">Icon (Font Awesome class)</label>
            <input type="text" id="dept-icon" name="icon" class="form-control" placeholder="fa-solid fa-heart-pulse" value="<%=deta.icon%>" />
          </div>
          <div class="form-group">
            <label class="form-label" for="dept-image">Image URL</label>
            <input type="url" id="dept-image" name="image" class="form-control" placeholder="https://…" value="<%=deta.image%>" />
          </div>

          <div class="form-group">
            <label class="form-label" for="dept-image">Doctors</label>
            <input type="number" id="dept-image" name="doctor" class="form-control" placeholder="1,2,3,...." value="<%=deta.doctor%>" />
          </div>

        </div>
        <div class="form-group">
          <label class="form-label" for="dept-beds">Number of Beds</label>
          <input type="number" id="dept-beds" name="beds" class="form-control" min="0" placeholder="20" value="<%=deta.beds%>" />
        </div>
        <div class="form-group">
          <label class="form-label" for="dept-description">Description <span class="required">*</span></label>
          <textarea id="dept-description" name="description" class="form-control" rows="3" placeholder="Brief description of the department…" required>
            value="<%=deta.description%>"
          </textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="reset" class="btn btn-outline" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Department</button>
      </div>
    </form>
        <!-- <div class="page-toolbar">
          <h2>All Departments <span class="badge badge-primary" id="departments-count">0 of 0</span></h2>
          <div class="page-toolbar-actions">
            <button type="button" class="btn btn-outline" data-export-csv="#departments-table" data-filename="departments.csv">
              <i class="fa-solid fa-file-arrow-down"></i> Export CSV
            </button>
            <button type="button" class="btn btn-primary" id="add-department-btn">
              <i class="fa-solid fa-plus"></i> Add Department
            </button>
          </div>
        </div> -->

        <!-- <div class="dashboard-grid" id="departments-cards"></div> -->

        
        <div class="pagination" id="departments-pagination"></div>
      </main>
    </div>
  </div>

  <!-- Add / Edit Department Modal -->
  <div class="modal-backdrop" id="department-modal-backdrop"></div>
  <div class="modal modal-lg" id="department-modal" role="dialog" aria-modal="true" aria-labelledby="department-modal-title">
   
  </div>

<%-include('footer.ejs');%>



