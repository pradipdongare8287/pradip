<%-include('header.ejs');%>

    <div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Medicine Inventory</h1>
            <p>Pharmacy stock &amp; medicine catalog</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="medicines-search" placeholder="Search medicines…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings.html"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="login.html" class="danger logout-btn" data-logout="login.html"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <main class="dashboard-content">
        <div class="stat-cards" style="margin-bottom:1.75rem;">
          <div class="stat-card">
            <div class="stat-card-icon blue"><i class="fa-solid fa-pills"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Total Medicines</div>
              <div class="stat-card-value" id="med-stat-total">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon green"><i class="fa-solid fa-box-open"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">In Stock</div>
              <div class="stat-card-value" id="med-stat-instock">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon orange"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Low Stock</div>
              <div class="stat-card-value" id="med-stat-lowstock">0</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon purple"><i class="fa-solid fa-ban"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Out of Stock</div>
              <div class="stat-card-value" id="med-stat-outstock">0</div>
            </div>
          </div>
        </div>

        <div class="page-toolbar">
          <h2>Medicine Catalog <span class="badge badge-primary" id="medicines-count">0 of 0</span></h2>
          <div class="page-toolbar-actions">
            <select id="medicines-stock-filter" class="form-control" style="max-width:180px;">
              <option value="all">All Stock Levels</option>
              <option value="in-stock">In Stock</option>
              <option value="low-stock">Low Stock</option>
              <option value="out-of-stock">Out of Stock</option>
            </select>
            <button type="button" class="btn btn-outline" data-export-csv="#medicines-table" data-filename="medicines.csv">
              <i class="fa-solid fa-file-arrow-down"></i> Export CSV
            </button>
            <button type="button" class="btn btn-primary" id="add-medicine-btn">
              <i class="fa-solid fa-plus"></i> Add Medicine
            </button>
          </div>
        </div>

        <div class="table-wrapper">
          <table class="table" id="medicines-table">
            <thead>
              <tr>
                <th>Medicine</th>
                <th>Category</th>
                <th>Stock Qty</th>
                <th>Price</th>
                <th>Stock Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="medicines-tbody"></tbody>
          </table>
        </div>
        <div class="pagination" id="medicines-pagination"></div>
      </main>
    </div>
  </div>

  <!-- Add / Edit Medicine Modal -->
  <div class="modal-backdrop" id="medicine-modal-backdrop"></div>
  <div class="modal modal-lg" id="medicine-modal" role="dialog" aria-modal="true" aria-labelledby="medicine-modal-title">
    <div class="modal-header">
      <h3 id="medicine-modal-title">Add New Medicine</h3>
      <button type="button" class="modal-close" data-modal-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form id="medicine-form">
      <div class="modal-body">
        <input type="hidden" name="id" />
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="med-name">Medicine Name <span class="required">*</span></label>
            <input type="text" id="med-name" name="name" class="form-control" placeholder="Paracetamol 500mg" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="med-category">Category <span class="required">*</span></label>
            <input type="text" id="med-category" name="category" class="form-control" placeholder="Pain Relief" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="med-price">Price ($) <span class="required">*</span></label>
            <input type="number" id="med-price" name="price" class="form-control" min="0" step="0.01" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="med-stock">Stock Quantity <span class="required">*</span></label>
            <input type="number" id="med-stock" name="stock" class="form-control" min="0" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="med-unit">Unit</label>
            <select id="med-unit" name="unit" class="form-control">
              <option value="strip">Strip</option>
              <option value="pack">Pack</option>
              <option value="bottle">Bottle</option>
              <option value="unit">Unit</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="med-manufacturer">Manufacturer</label>
            <input type="text" id="med-manufacturer" name="manufacturer" class="form-control" placeholder="e.g. HeartCare Labs" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="med-description">Description</label>
          <textarea id="med-description" name="description" class="form-control" rows="3" placeholder="Usage / dosage details…"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Medicine</button>
      </div>
    </form>
  </div>
<%-include('footer.ejs');%>

  
