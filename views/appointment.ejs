
<%-include('header.ejs');%>

  <main id="main-content">
    <section class="page-banner">
      <div class="container">
        <h1>Book an Appointment</h1>
        <div class="breadcrumb">
          <a href="/">Home</a>
          <i class="fa-solid fa-chevron-right"></i>
          <span>Appointment</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="contact-grid">
          <!-- Sidebar info -->
          <div class="contact-info-cards" data-aos="fade-right">
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-regular fa-clock"></i></div>
              <div>
                <h4>Working Hours</h4>
                <p>Mon–Fri: 8:00 AM – 8:00 PM<br>Sat: 9:00 AM – 5:00 PM<br>Sun: Emergency Only</p>
              </div>
            </div>
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-solid fa-phone"></i></div>
              <div>
                <h4>Need Help Booking?</h4>
                <p>+1 (800) 555-0147<br>Emergency: 108</p>
              </div>
            </div>
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-solid fa-file-medical"></i></div>
              <div>
                <h4>What to Bring</h4>
                <p>Photo ID, insurance card (if any), current medications, and prior medical reports.</p>
              </div>
            </div>
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-solid fa-circle-info"></i></div>
              <div>
                <h4>Good to Know</h4>
                <p>Appointments are confirmed as <strong>Pending</strong> until reviewed by our team — you'll see status updates in your patient dashboard.</p>
              </div>
            </div>
          </div>

          <!-- Appointment form -->
          <div class="contact-form-card" data-aos="fade-left">
            <h3><i class="fa-solid fa-calendar-plus text-primary"></i> Appointment Details</h3>
            <p>Fill in your information below. Available time slots update automatically based on the doctor and date you choose.</p>

            <form action="/Web_appointment_petient" method="post">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="apt-name">Full Name <span class="required">*</span></label>
                  <input type="text" id="apt-name" name="app_patientName" class="form-control" placeholder="Your full name" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="apt-phone">Phone Number <span class="required">*</span></label>
                  <input type="tel" id="apt-phone" name="app_phone" class="form-control" placeholder="+1 (555) 000-0000" required />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="apt-email">Email Address</label>
                <input type="email" id="apt-email" name="app_email" class="form-control" placeholder="you@example.com" required />
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="apt-dept">Department <span class="required">*</span></label>
                  <select id="apt-dept" name="app_departmentname" class="form-control" data-dept-select required>
                    <option value="">Select Department</option>
                    <% for(var i=0;i<department.length;i++){ %>
                        <option><%=department[i].dname%></option>
                      <% } %>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label" for="apt-doctor">Doctor <span class="required"></span></label>
                  <select id="apt-doctor" name="app_doctorname" class="form-control"  required>
                    <option value="">Select Doctor</option>
                    <% for(var i=0;i<doctors.length;i++){ %>
                        <option><%=doctors[i].doc_name%></option>
                      <% } %>
                  </select>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" >Preferred Date <span class="required"></span></label>
                  <input type="date"  name="app_date" class="form-control"  required />
                </div>
                <div class="form-group">
                  <label class="form-label" >Preferred Time <span class="required"></span></label>
                  <input type="time"  name="app_time" class="form-control"  />
                  
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="apt-reason">Reason for Visit</label>
                <textarea id="apt-reason" name="app_reason" class="form-control" rows="4" placeholder="Briefly describe your symptoms or reason for the visit..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg btn-block">
                <i class="fa-solid fa-paper-plane"></i> Request Appointment
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  <%-include('footer.ejs');%>