<%-include('header.ejs');%>

  <div class="dashboard-content">

    <!-- Builder form -->
    <div class="dashboard-panel" style="margin-bottom:1.75rem;">
      <div class="dashboard-panel-header">
        <h3> Prescription Bill</h3>
      </div>
    
    </div>

    <!-- Printable preview -->
    <div style="margin-bottom:1.75rem;">
      <div class="page-toolbar" style="margin-bottom:1rem;">
        <h2>Prescription Preview</h2>
        <div class="page-toolbar-actions">
          <button type="button" class="btn btn-primary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
        </div>
      </div>

      <div class="prescription-area prescription-print">
        <div class="prescription-header">
          <div class="rx-brand">
            <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
            <div>
              <h2>MediCare Plus</h2>
              <p>1250 Healing Way, Suite 100, Health City, HC 90210</p>
            </div>
          </div>
          <div class="rx-meta">
            <strong><%=patient[0].Doc_name%></strong>
            <span><%=doctor_department%></span><br />
            <span>Rx No: RX2041</span><br />
            <span>Date:-   &nbsp;&nbsp; <%=patient[0].Pre_date%></span>
          </div>
        </div>

        <div class="prescription-patient">
          <div class="rx-field">
            <label>Patient Name</label>
            <span><%=patient[0].Patient_name%></span>
          </div>
          <div class="rx-field">
            <label>Age / Gender</label>
            <span>42 / Male</span>
          </div>
          <div class="rx-field">
            <label>Patient ID</label>
            <span>PT-1042</span>
          </div>
        </div>

        <div class="rx-field" style="margin-bottom:1.5rem;">
          <label>Diagnosis</label><br>
          &nbsp;&nbsp;&nbsp;<span><%=patient[0].Pre_diagnosis%></span>
        </div>

        <div class="prescription-rx">
          <div class="rx-symbol">℞</div>
          <table class="prescription-meds">
            <thead>
              <tr>
                <th>Medicine</th>
                <th>Dosage</th>
                <th>Frequency</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <% for(var i=0;i<patient.length;i++){ %>

              <tr>
                <td><%=patient[i].Medicine%></td>
                <td><%=patient[i].Dosage%></td>
                <td><%=patient[i].Frequency%></td>
                <td><%=patient[i].Duration%></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="prescription-notes">
          <h5><i class="fa-solid fa-circle-info"></i> Advice</h5>
          <p><%=patient[0].Pre_advice%></p>
        </div>

        <div class="prescription-footer">
          <div>
            <p class="text-muted" style="font-size:0.8rem;margin:0;">This is a computer-generated prescription —
              MediCare Plus.</p>
          </div>
          <div class="rx-signature">
            <div class="sig-line"></div>
            <span><%=patient[0].Doc_name%></span>
            
          </div>
        </div>
      </div>
    </div>

    <!-- History -->
 

  </div>
  </div>
  </div>
  <%-include('footer.ejs');%>