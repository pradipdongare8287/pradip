<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Read real patient stories and testimonials from families who trusted MediCare Plus with their health and recovery." />
  <meta name="keywords" content="patient testimonials, patient reviews, hospital reviews" />
  <meta name="author" content="MediCare Plus" />
  <title>Patient Testimonials | MediCare Plus</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  <link rel="stylesheet" href="css/main.css" />
</head>
<body data-page="testimonials">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <div class="page-loader" id="page-loader">
    <div class="loader-pulse"></div>
    <span class="loader-text">MediCare Plus</span>
  </div>

  <div id="site-header"></div>

  <main id="main-content">
    <section class="page-banner">
      <div class="container">
        <h1>Patient Testimonials</h1>
        <div class="breadcrumb">
          <a href="index.html">Home</a>
          <i class="fa-solid fa-chevron-right"></i>
          <span>Testimonials</span>
        </div>
      </div>
    </section>

    <!-- Rating summary -->
    <section class="section stats-section">
      <div class="container">
        <div class="stats-grid" data-aos="fade-up">
          <div class="stat-item">
            <div class="stat-icon blue"><i class="fa-solid fa-star"></i></div>
            <div class="stat-number">4.9<span class="suffix">/5</span></div>
            <div class="stat-label">Average Rating</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon green"><i class="fa-solid fa-comment-medical"></i></div>
            <div class="stat-number" data-counter="1280" data-suffix="+">0</div>
            <div class="stat-label">Verified Reviews</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon orange"><i class="fa-solid fa-hospital-user"></i></div>
            <div class="stat-number" data-counter="45000" data-suffix="+">0</div>
            <div class="stat-label">Patients Served</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon red"><i class="fa-solid fa-thumbs-up"></i></div>
            <div class="stat-number" data-counter="97" data-suffix="%">0</div>
            <div class="stat-label">Would Recommend</div>
          </div>
        </div>
      </div>
    </section>

    <!-- All testimonials -->
    <section class="section bg-alt">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <span class="eyebrow">In Their Words</span>
          <h2>Stories From Our Patients</h2>
          <p>Real experiences shared by patients and families across every department.</p>
        </div>
        <div class="testimonial-grid" data-testimonials-grid></div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container">
        <div class="cta-banner" data-aos="fade-up">
          <div class="container">
            <h2>Had a Great Experience With Us?</h2>
            <p>We would love to hear your story — it helps other families choose the right care.</p>
            <div class="btn-group">
              <a href="contact.html" class="btn btn-white btn-lg"><i class="fa-solid fa-comment-medical"></i> Share Your Story</a>
              <a href="appointment.html" class="btn btn-outline-white btn-lg">Book an Appointment</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div id="site-footer"></div>
  <div id="floating-buttons"></div>
  <div class="toast-container"></div>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script src="js/data.js"></script>
  <script src="js/auth.js"></script>
  <script src="js/components.js"></script>
  <script src="js/appointment.js"></script>
  <script src="js/dashboard.js"></script>
  <script src="js/main.js"></script>
  <script src="js/pages.js"></script>
</body>
</html>
